<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Флаг «гайд показан» — состояние устройства, а не пользователя: ни в облако, ни на новый телефон. -->
    <cloud-backup>
        <exclude domain="sharedpref" path="local_state.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="local_state.xml" />
    </device-transfer>
</data-extraction-rules>
