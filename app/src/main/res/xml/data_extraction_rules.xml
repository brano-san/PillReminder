<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Медицинские данные уезжают в облако только при сквозном шифровании резервной копии;
         флаг «гайд показан» — состояние устройства, а не пользователя. -->
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <exclude domain="sharedpref" path="local_state.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="local_state.xml" />
    </device-transfer>
</data-extraction-rules>
