{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Собрать APK (debug)",
      "type": "shell",
      "command": ".\\gradlew.bat assembleDebug",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "Собрать релиз (подписанный)",
      "type": "shell",
      "command": ".\\gradlew.bat assembleRelease",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Собрать и поставить на телефон",
      "type": "shell",
      "command": ".\\gradlew.bat installDebug",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Запустить приложение на телефоне",
      "type": "shell",
      "command": "adb shell am start -n tech.unispace.pillreminder/.MainActivity",
      "problemMatcher": []
    },
    {
      "label": "Устройства (adb devices)",
      "type": "shell",
      "command": "adb devices -l",
      "problemMatcher": []
    },
    {
      "label": "Логи приложения",
      "type": "shell",
      "command": "adb logcat --pid=$(adb shell pidof -s tech.unispace.pillreminder)",
      "problemMatcher": []
    },
    {
      "label": "Очистить сборку",
      "type": "shell",
      "command": ".\\gradlew.bat clean",
      "problemMatcher": []
    }
  ]
}
